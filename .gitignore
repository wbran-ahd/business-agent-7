bun.lock

# Build output — generated, never committed; deploy from dist/ or rebuild.
dist/

# Platform preview/build workspace artifacts.
freebuff-sites-build/

# Local dev/premium logs and generated PWA leftovers.
*.log
.logs/

# AI Studio scratch pastes (build-time inputs, not app assets).
public/assets/aistudio/
.aistudio/

# Freebuff workspace scratch/markers (not user project files).
.freebuff/
.freebuff-project-id

# Artifacts folder (generated images / exports) — regenerate locally.
artifacts/

# Firebase CLI local state and admin credentials.
# A service-account JSON can bypass every Firestore rule, so it must never reach
# a commit or an archive.
.firebase/
*-firebase-adminsdk-*.json

# Vercel leftovers.
.vercel
.vercel-vendor/

# Node dependency trees — use bun.lock for the frontend and
# functions/package-lock.json only if you intentionally commit it.
node_modules/
functions/node_modules/

# Compiled Cloud Functions output. Source stays in functions/src/; the compiled
# lib/ and its map files are build artifacts, not source.
functions/lib/

# Secrets and local env files — set these through your platform/secret manager,
# never in the repo.
.env
.env.*
!.env.example
functions/.env
functions/.env.*
!.env.example
functions/.secret.local

# Stale package-manager lock from a different package manager.
yarn.lock
