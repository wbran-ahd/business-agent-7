# Environment files: real values stay local, only the template is tracked.
.env
.env.*
!.env.example

# Build output — generated, never committed; deploy from dist/ or rebuild.
dist/

# Platform preview/build workspace artifacts.
freebuff-sites-build/

# Node dependency trees — use bun.lock for the frontend.
node_modules/

# Firebase CLI local state and admin credentials.
# A service-account JSON can bypass every Firestore rule, so it must never reach
# a commit or an archive.
.firebase/
*-firebase-adminsdk-*.json

# Vercel leftovers.
.vercel
# Vendored Vercel CLI that only the local preview script uses.
.vercel-vendor/

# Local dev/preview logs and generated PWA leftovers.
*.log
.logs/

# AI Studio scratch pastes (build-time inputs, not app assets).
public/assets/aistudio/
.aistudio/

# Freebuff workspace scratch/markers (not user project files).
.freebuff/
.freebuff-project-id

# Artifacts folder (generated images / exports) — regenerate locally.
artifacts/

# Stale package-manager lock from a different package manager.
yarn.lock

# Generated by scripts/build-jwt.* — encoded tokens and decoded claim dumps
# (they carry claim data/PII). Regenerate locally; never commit them.
scripts/jwt-token.txt
scripts/jwt-payload.json
scripts/jwt-verify.txt

# src/convex/_generated is committed on purpose: it holds the Convex API types
# that the app and the CI typecheck import, and nothing typechecks without it.
# `convex dev` / `convex deploy` regenerate it, so keep it in sync with src/convex.
