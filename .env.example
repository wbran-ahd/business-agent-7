# ---------------------------------------------------------------------------
# صوتی بقیہ / Sauti Baqaya — environment template
#
# Copy to `.env.local` (gitignored) for local development and fill it in.
# Vite only exposes `VITE_*` variables to the browser; the rest are read by the
# Convex CLI or must be set on the Convex deployment itself.
# ---------------------------------------------------------------------------

# --- Client (read by the Vite app, exposed to the browser) ------------------
# Convex deployment the browser connects to. Local dev: `bunx convex dev`
# writes this automatically.
VITE_CONVEX_URL=

# Public origin used for absolute Open Graph / WhatsApp preview URLs, e.g.
# https://sauti.example.com (no trailing slash). Leave empty on localhost.
VITE_PUBLIC_ORIGIN=

# Support / sales line for WhatsApp (international digits, no + or spaces),
# e.g. 923001234567. Empty hides the direct-chat buttons.
VITE_SUPPORT_WHATSAPP=

# Receiving numbers for the manual JazzCash / EasyPaisa flow. Empty disables the
# corresponding "send money to this number" button.
VITE_JAZZCASH_NUMBER=
VITE_EASYPAISA_NUMBER=

# Optional collector for field-test telemetry batches (POST JSON). Unset keeps
# telemetry entirely on the device.
VITE_TELEMETRY_URL=
# Convex HTTP-actions ("site") URL, used by Convex Auth for OIDC discovery.
VITE_CONVEX_SITE_URL=

# --- Convex CLI (read by `bunx convex dev` / `bunx convex deploy`) ----------
# Deployment selector written by `convex dev`, e.g. `dev:happy-cat-123`.
CONVEX_DEPLOYMENT=

# --- Convex backend environment variables (set with `convex env set`) -------
# NOTE: on a deployment `CONVEX_SITE_URL` is built in and cannot be overridden;
# it is listed here only to document the value Convex Auth uses as the OIDC
# issuer (must match the site URL the deployment serves).
CONVEX_SITE_URL=http://localhost:5173

# Convex Auth: `SITE_URL` plus the signing key pair generated for you by
# `bunx @convex-dev/auth`.
SITE_URL=http://localhost:5173
JWT_PRIVATE_KEY=
JWKS=

# Freebuff/VLY integration gateway — AI completions, email OTP sign-in codes
# and payment billing are all proxied through it and billed by usage.
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.freebuff.com/

# Issuer of federated freebuff-signed JWTs (auth.config.ts customJwt provider).
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# Optional: server-side Gemini key for AI advice, and the AES-GCM secret that
# encrypts per-user Gemini keys stored in the database.
GEMINI_API_KEY=
SAUTI_KEY_SECRET=
