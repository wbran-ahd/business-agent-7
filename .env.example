SAUTI_KEY_SECRET=
SITE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_PUBLIC_ORIGIN=
VITE_SUPPORT_WHATSAPP=
VITE_TELEMETRY_URL=
VLY_INTEGRATION_BASE_URL=
VLY_INTEGRATION_KEY=

# ═══ اختیاری: Sentry (خرابی کی رپورٹ) ═══
# کہاں سے: https://sentry.io → Project → Settings → Client Keys (DSN)
# خالی چھوڑیں تو ایپ بالکل ویسے ہی چلے گی (کوئی نیٹ ورک کال نہیں)۔
# تفصیل: docs/SETUP-ACCOUNTS.md
VITE_SENTRY_DSN=

# ═══ اختیاری: PostHog (صارف کی نقل و حرکت) ═══
# کہاں سے: https://posthog.com → Project Settings → Project API Key (phc_…)
# خالی چھوڑیں تو کوئی analytics SDK لوڈ ہی نہیں ہوگا۔
VITE_POSTHOG_KEY=
# امریکہ: https://us.i.posthog.com | یورپ: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ═══ اختیاری: Firebase App Check (API کی حفاظت) ═══
# کہاں سے: Firebase Console → App Check → Web app → reCAPTCHA v3 site key
# خالی چھوڑیں تو App Check رجسٹر ہی نہیں ہوگا۔
# ⚠️ Console میں "Enforce" اس وقت تک نہ چلائیں جب تک ہر کلائنٹ ٹوکن نہ بھیجے۔
VITE_RECAPTCHA_SITE_KEY=
