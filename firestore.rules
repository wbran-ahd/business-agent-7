rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------------------
    // Activation licensing helpers
    //
    // Admin is identified by a hard-coded Firebase Auth uid (decision 2):
    // there is no admin claim, no admins document and no login screen of its
    // own. Replace the placeholder below with the uid of the admin account
    // before deploying rules; until then this helper matches nobody, so every
    // admin read fails closed.
    //
    // The licensing collections themselves are written only by Cloud
    // Functions with the Admin SDK (which bypasses these rules). Clients never
    // write a code, a licence, a rate-limit counter or an audit entry.
    // ---------------------------------------------------------------------
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'vDzRVOYUgMNwcvD5oBdPVibDFFq1';
    }

    // ---------------------------------------------------------------------
    // Licence-backed feature gate (enforcement #5).
    //
    // The AI advisor is still a local stub, so the only server-side lever we
    // have is this: the Gemini key may not be stored in Firestore unless the
    // caller's licence is active and carries the `ai` feature. `let` binding
    // keeps it to one get() per evaluation (rules allow 10 per request).
    // ---------------------------------------------------------------------
    function licensePath() {
      return /databases/$(database)/documents/licenses/$(request.auth.uid);
    }

    function licenceHolds(feature) {
      let licence = get(licensePath()).data;
      let expiry = licence.get('license_expires_at', null);
      return licence.get('revoked', false) == false
        && (expiry == null || ((expiry is int || expiry is float) && expiry > request.time.toMillis()))
        && feature in licence.get('features', []);
    }

    function hasActiveFeature(feature) {
      return isSignedIn()
        && exists(licensePath())
        && licenceHolds(feature);
    }

    // True when this request is actually storing a *new* Gemini key.
    // `incoming()` is the merged document, so a settings write that merely
    // carries an existing key must not re-trigger the gate — otherwise budgets
    // would stop saving the moment a key was set once.
    function writesAiKey(isNewDoc) {
      return 'geminiKey' in incoming()
        && incoming().geminiKey is string
        && incoming().geminiKey.size() > 0
        && (isNewDoc
            || !('geminiKey' in resource.data)
            || resource.data.geminiKey != incoming().geminiKey);
    }

    // Test connection doc for initial boot verification
    match /test/connection {
      allow get: if true;
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().id == userId
        && (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 100))
        && (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 200))
        && (!('isAnonymous' in incoming()) || incoming().isAnonymous is bool);
      allow update: if isOwner(userId)
        && incoming().id == existing().id
        && (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 100))
        && (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 200))
        && (!('isAnonymous' in incoming()) || incoming().isAnonymous is bool);
      allow delete: if isOwner(userId);

      // Records subcollection
      match /records/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(recordId)
          && incoming().localId is number
          && (incoming().kind == 'income' || incoming().kind == 'expense')
          && incoming().amount is number
          && incoming().monthKey is string && incoming().monthKey.size() <= 10
          && incoming().timestamp is number
          && (!('detail' in incoming()) || (incoming().detail is string && incoming().detail.size() <= 500))
          && (!('category' in incoming()) || (incoming().category is string && incoming().category.size() <= 100))
          && (!('icon' in incoming()) || (incoming().icon is string && incoming().icon.size() <= 100))
          && (!('account' in incoming()) || (incoming().account in ['cash', 'bank']));
        allow update: if isOwner(userId)
          && isValidId(recordId)
          && incoming().localId == existing().localId
          && (incoming().kind == 'income' || incoming().kind == 'expense')
          && incoming().amount is number
          && incoming().monthKey is string && incoming().monthKey.size() <= 10
          && incoming().timestamp is number
          && (!('detail' in incoming()) || (incoming().detail is string && incoming().detail.size() <= 500))
          && (!('category' in incoming()) || (incoming().category is string && incoming().category.size() <= 100))
          && (!('icon' in incoming()) || (incoming().icon is string && incoming().icon.size() <= 100))
          && (!('account' in incoming()) || (incoming().account in ['cash', 'bank']));
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      // Settings doc
      match /settings/{docId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
          && (!('geminiKey' in incoming()) || (incoming().geminiKey is string && incoming().geminiKey.size() <= 200))
          && (!writesAiKey(true) || hasActiveFeature('ai'));
        allow update: if isOwner(userId)
          && (!('geminiKey' in incoming()) || (incoming().geminiKey is string && incoming().geminiKey.size() <= 200))
          && (!writesAiKey(false) || hasActiveFeature('ai'));
        allow delete: if isOwner(userId);
      }

      // Sync concurrency state
      match /sync/{docId} {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && incoming().version is number;
        allow delete: if isOwner(userId);
      }

      // Customer / supplier book — merged in phase 3. These two subcollections
      // were already written by `use-parties` but had no rules at all, so
      // default-deny silently blocked every cloud write.
      match /parties/{partyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(partyId)
          && incoming().id is number
          && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100
          && incoming().phone is string && incoming().phone.size() <= 20
          && incoming().kind in ['customer', 'supplier']
          && incoming().createdAt is number
          && (!('note' in incoming()) || incoming().note == null
              || (incoming().note is string && incoming().note.size() <= 500));
        allow update: if isOwner(userId)
          && isValidId(partyId)
          && incoming().id == existing().id
          && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100
          && incoming().phone is string && incoming().phone.size() <= 20
          && incoming().kind in ['customer', 'supplier']
          && incoming().createdAt == existing().createdAt
          && (!('note' in incoming()) || incoming().note == null
              || (incoming().note is string && incoming().note.size() <= 500));
        allow delete: if isOwner(userId) && isValidId(partyId);
      }

      match /partyTxns/{txnId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(txnId)
          && incoming().id is number
          && incoming().partyId is number
          && incoming().kind in ['charge', 'payment']
          && incoming().amount is number
          && incoming().account in ['cash', 'bank']
          && incoming().timestamp is number
          && incoming().note is string && incoming().note.size() <= 500
          && incoming().date is string && incoming().date.size() <= 50
          && incoming().time is string && incoming().time.size() <= 50;
        allow update: if isOwner(userId)
          && isValidId(txnId)
          && incoming().id == existing().id
          && incoming().partyId == existing().partyId
          && incoming().kind in ['charge', 'payment']
          && incoming().amount is number
          && incoming().account in ['cash', 'bank']
          && incoming().timestamp == existing().timestamp
          && incoming().note is string && incoming().note.size() <= 500
          && incoming().date is string && incoming().date.size() <= 50
          && incoming().time is string && incoming().time.size() <= 50;
        allow delete: if isOwner(userId) && isValidId(txnId);
      }
    }

    // ---------------------------------------------------------------------
    // Activation licensing — merged in phase 2, additive only. Everything
    // above (users, records, settings, sync) is unchanged.
    // ---------------------------------------------------------------------

    // Voucher codes. The plain code is never stored, only its hash; admin may
    // read the list to render the panel, nobody may write from a client.
    match /codes/{codeId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // Per-user licence, keyed by uid so `/licenses/{uid}` is the owner's own
    // document. Writes come from Functions only (activate, reset, revoke).
    match /licenses/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Append-only trail of admin and activation actions.
    match /audit_log/{entryId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // Sliding-window counters for rate limiting. Server-side only.
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    // Reserved. Admin identity is the hard-coded uid above, not a document,
    // so this collection is deliberately unreachable from any client.
    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
